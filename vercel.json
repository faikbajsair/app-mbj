{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!css/|js/|gas/|public/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
